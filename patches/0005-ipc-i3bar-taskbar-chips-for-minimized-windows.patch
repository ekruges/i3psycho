+/*
+ * vim:ts=4:sw=4:expandtab
+ *
+ * i3bar - an xcb-based status- and ws-bar for i3
+ * © 2010 Axel Wagner and contributors (see also: LICENSE)
+ *
+ * scratchpad.h: Chips for minimized (scratchpad) windows, rendered next to
+ * the workspace buttons like a classic taskbar.
+ *
+ */
+#pragma once
+
+#include <config.h>
+
+#include <cairo.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "common.h"
+
+typedef struct sp_item {
+    /* i3 container id, used for the restore command */
+    long id;
+    /* X11 window, used to fetch _NET_WM_ICON */
+    uint32_t window;
+    bool urgent;
+    /* first letter of the window class, the icon fallback */
+    i3String *letter;
+    /* native-size ARGB icon, may be NULL */
+    cairo_surface_t *icon;
+    int icon_w;
+    int icon_h;
+
+    TAILQ_ENTRY(sp_item) entries;
+} sp_item;
+
+TAILQ_HEAD(sp_head, sp_item);
+extern struct sp_head sp_items;
+
+/* Blink phase for urgent chips, toggled by a timer. */
+extern bool sp_pulse_on;
+
+/**
+ * Parse a GET_SCRATCHPAD reply, reusing already-fetched icons.
+ *
+ */
+void parse_scratchpad_json(const unsigned char *json, size_t size);
+
+int scratchpad_count(void);
+
+/**
+ * Restore the n-th chip's window (sends the command to i3).
+ *
+ */
+void scratchpad_restore(int index);
+
+/**
+ * Start the urgency pulse timer on main_loop.
+ *
+ */
+void scratchpad_init(void);
