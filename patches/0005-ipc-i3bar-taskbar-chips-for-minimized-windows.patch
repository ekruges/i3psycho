diff --git a/i3bar/src/scratchpad.c b/i3bar/src/scratchpad.c
new file mode 100644
index 00000000..ea60fb16
--- /dev/null
+++ b/i3bar/src/scratchpad.c
@@ -0,0 +1,274 @@
+/*
+ * vim:ts=4:sw=4:expandtab
+ *
+ * i3bar - an xcb-based status- and ws-bar for i3
+ * © 2010 Axel Wagner and contributors (see also: LICENSE)
+ *
+ * scratchpad.c: Chips for minimized (scratchpad) windows, rendered next to
+ * the workspace buttons like a classic taskbar. The list comes from the
+ * GET_SCRATCHPAD IPC message, refreshed on every window event.
+ *
+ */
+#include "common.h"
+
+#include "i3/ipc.h"
+
+#include <ctype.h>
+#include <ev.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <yajl/yajl_parse.h>
+
+struct sp_head sp_items = TAILQ_HEAD_INITIALIZER(sp_items);
+
+bool sp_pulse_on = false;
+static ev_timer pulse_timer;
+
+extern xcb_connection_t *xcb_connection;
+
+/* The same atom enum xcb.c generates from xcb_atoms.def. */
+enum {
+#define ATOM_DO(name) name,
+#include "xcb_atoms.def"
+    NUM_ATOMS
+};
+extern xcb_atom_t atoms[];
+
+struct sp_json_params {
+    sp_item *walk;
+    char *cur_key;
+};
+
+static void sp_free_item(sp_item *item) {
+    if (item->letter != NULL) {
+        I3STRING_FREE(item->letter);
+    }
+    if (item->icon != NULL) {
+        cairo_surface_destroy(item->icon);
+    }
+    free(item);
+}
+
+/*
+ * Fetch _NET_WM_ICON for the window and convert the best-fitting frame to a
+ * premultiplied ARGB32 cairo surface.
+ *
+ */
+static void sp_fetch_icon(sp_item *item) {
+    xcb_get_property_cookie_t cookie = xcb_get_property(
+        xcb_connection, 0, item->window, atoms[_NET_WM_ICON],
+        XCB_ATOM_CARDINAL, 0, 256 * 1024);
+    xcb_get_property_reply_t *reply = xcb_get_property_reply(xcb_connection, cookie, NULL);
+    if (reply == NULL || reply->type != XCB_ATOM_CARDINAL || reply->format != 32) {
+        free(reply);
+        return;
+    }
+    const uint32_t len = xcb_get_property_value_length(reply) / 4;
+    const uint32_t *data = xcb_get_property_value(reply);
+
+    /* Frames are (width, height, pixels...); pick the smallest one that is
+     * still at least 24px, or the largest overall. */
+    const uint32_t target = 24;
+    uint32_t best_off = 0, best_w = 0, best_h = 0;
+    for (uint32_t off = 0; off + 2 <= len;) {
+        const uint32_t w = data[off], h = data[off + 1];
+        if (w == 0 || h == 0 || off + 2 + w * h > len) {
+            break;
+        }
+        const bool better = (best_w == 0) ||
+                            (w >= target && (best_w < target || w < best_w)) ||
+                            (w < target && best_w < target && w > best_w);
+        if (better) {
+            best_off = off + 2;
+            best_w = w;
+            best_h = h;
+        }
+        off += 2 + w * h;
+    }
+    if (best_w == 0) {
+        free(reply);
+        return;
+    }
+
+    cairo_surface_t *surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, best_w, best_h);
+    if (cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS) {
+        free(reply);
+        return;
+    }
+    uint32_t *pixels = (uint32_t *)cairo_image_surface_get_data(surface);
+    const int stride = cairo_image_surface_get_stride(surface) / 4;
+    for (uint32_t y = 0; y < best_h; y++) {
+        for (uint32_t x = 0; x < best_w; x++) {
+            const uint32_t argb = data[best_off + y * best_w + x];
+            const uint32_t a = argb >> 24;
+            const uint32_t r = ((argb >> 16) & 0xFF) * a / 255;
+            const uint32_t g = ((argb >> 8) & 0xFF) * a / 255;
+            const uint32_t b = (argb & 0xFF) * a / 255;
+            pixels[y * stride + x] = (a << 24) | (r << 16) | (g << 8) | b;
+        }
+    }
+    cairo_surface_mark_dirty(surface);
+    item->icon = surface;
+    item->icon_w = best_w;
+    item->icon_h = best_h;
+    free(reply);
+}
+
+static int sp_boolean_cb(void *params_, const int val) {
+    struct sp_json_params *params = params_;
+    if (params->cur_key != NULL && strcmp(params->cur_key, "urgent") == 0) {
+        params->walk->urgent = val;
+    }
+    FREE(params->cur_key);
+    return 1;
+}
+
+static int sp_integer_cb(void *params_, const long long val) {
+    struct sp_json_params *params = params_;
+    if (params->cur_key == NULL) {
+        return 1;
+    }
+    if (strcmp(params->cur_key, "id") == 0) {
+        params->walk->id = (long)val;
+    } else if (strcmp(params->cur_key, "window") == 0) {
+        params->walk->window = (uint32_t)val;
+    }
+    FREE(params->cur_key);
+    return 1;
+}
+
+static int sp_string_cb(void *params_, const unsigned char *val, const size_t len) {
+    struct sp_json_params *params = params_;
+    if (params->cur_key != NULL && strcmp(params->cur_key, "class") == 0 && len > 0) {
+        char letter[2] = {(char)toupper(val[0]), '\0'};
+        params->walk->letter = i3string_from_utf8(letter);
+    }
+    FREE(params->cur_key);
+    return 1;
+}
+
+static int sp_start_map_cb(void *params_) {
+    struct sp_json_params *params = params_;
+    params->walk = scalloc(1, sizeof(sp_item));
+    return 1;
+}
+
+static int sp_end_map_cb(void *params_) {
+    struct sp_json_params *params = params_;
+    TAILQ_INSERT_TAIL(&sp_items, params->walk, entries);
+    params->walk = NULL;
+    return 1;
+}
+
+static int sp_map_key_cb(void *params_, const unsigned char *keyVal, const size_t keyLen) {
+    struct sp_json_params *params = params_;
+    FREE(params->cur_key);
+    params->cur_key = sstrndup((const char *)keyVal, keyLen);
+    return 1;
+}
+
+static yajl_callbacks sp_callbacks = {
+    .yajl_boolean = sp_boolean_cb,
+    .yajl_integer = sp_integer_cb,
+    .yajl_string = sp_string_cb,
+    .yajl_start_map = sp_start_map_cb,
+    .yajl_end_map = sp_end_map_cb,
+    .yajl_map_key = sp_map_key_cb,
+};
+
+void parse_scratchpad_json(const unsigned char *json, size_t size) {
+    /* Keep the old list around so already-fetched icons can be reused.
+     * Move the elements (a TAILQ head must not be copied by value: the
+     * first element still points back at the old head). */
+    struct sp_head old;
+    TAILQ_INIT(&old);
+    while (!TAILQ_EMPTY(&sp_items)) {
+        sp_item *moved = TAILQ_FIRST(&sp_items);
+        TAILQ_REMOVE(&sp_items, moved, entries);
+        TAILQ_INSERT_TAIL(&old, moved, entries);
+    }
+
+    struct sp_json_params params = {NULL, NULL};
+    yajl_handle handle = yajl_alloc(&sp_callbacks, NULL, &params);
+    yajl_status state = yajl_parse(handle, json, size);
+    if (state != yajl_status_ok) {
+        ELOG("Could not parse scratchpad reply!\n");
+    }
+    yajl_complete_parse(handle);
+    yajl_free(handle);
+    FREE(params.cur_key);
+    if (params.walk != NULL) {
+        sp_free_item(params.walk);
+    }
+
+    sp_item *item;
+    TAILQ_FOREACH (item, &sp_items, entries) {
+        sp_item *old_walk, *found = NULL;
+        TAILQ_FOREACH (old_walk, &old, entries) {
+            if (old_walk->window == item->window && old_walk->icon != NULL) {
+                found = old_walk;
+                break;
+            }
+        }
+        if (found != NULL) {
+            item->icon = found->icon;
+            item->icon_w = found->icon_w;
+            item->icon_h = found->icon_h;
+            found->icon = NULL;
+        } else {
+            sp_fetch_icon(item);
+        }
+    }
+
+    while (!TAILQ_EMPTY(&old)) {
+        sp_item *old_item = TAILQ_FIRST(&old);
+        TAILQ_REMOVE(&old, old_item, entries);
+        sp_free_item(old_item);
+    }
+}
+
+int scratchpad_count(void) {
+    int n = 0;
+    sp_item *item;
+    TAILQ_FOREACH (item, &sp_items, entries) {
+        n++;
+    }
+    return n;
+}
+
+void scratchpad_restore(int index) {
+    sp_item *item;
+    TAILQ_FOREACH (item, &sp_items, entries) {
+        if (index-- == 0) {
+            char *buffer;
+            sasprintf(&buffer, "[con_id=\"%ld\"] scratchpad show", item->id);
+            i3_send_msg(I3_IPC_MESSAGE_TYPE_RUN_COMMAND, buffer);
+            free(buffer);
+            return;
+        }
+    }
+}
+
+static void pulse_cb(struct ev_loop *loop, ev_timer *timer, int revents) {
+    bool any_urgent = false;
+    sp_item *item;
+    TAILQ_FOREACH (item, &sp_items, entries) {
+        if (item->urgent) {
+            any_urgent = true;
+            break;
+        }
+    }
+    if (any_urgent) {
+        sp_pulse_on = !sp_pulse_on;
+        draw_bars(false);
+    } else if (sp_pulse_on) {
+        sp_pulse_on = false;
+        draw_bars(false);
+    }
+}
+
+void scratchpad_init(void) {
+    ev_timer_init(&pulse_timer, &pulse_cb, 0.55, 0.55);
+    ev_timer_start(main_loop, &pulse_timer);
+}
