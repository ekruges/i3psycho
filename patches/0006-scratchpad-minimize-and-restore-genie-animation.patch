diff --git a/src/scratchpad.c b/src/scratchpad.c
index b323a803..8288fcda 100644
--- a/src/scratchpad.c
+++ b/src/scratchpad.c
@@ -32,6 +32,7 @@ void scratchpad_move(Con *con) {
