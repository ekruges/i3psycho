+        int sp_index = 0;
+        sp_item *sp_walk;
+        TAILQ_FOREACH (sp_walk, &sp_items, entries) {
+            if (x >= chip_x && x < chip_x + chip_w) {
+                scratchpad_restore(sp_index);
