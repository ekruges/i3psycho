# i3psycho — Phase 0 (config-only prototype)
# Floating-first i3 on a bone-stock i3 binary. Drop in as ~/.config/i3/config.

set $mod Mod4
font pango:DejaVu Sans 10

# ---- the point: everything floats ----
for_window [tiling] floating enable
floating_modifier $mod
default_floating_border normal 2
focus_follows_mouse no

# Force a titlebar even on windows that ask for none through _MOTIF_WM_HINTS
# (terminals do this most often). i3 honors that hint, and a window with no
# titlebar has nowhere to draw the close / iconify / maximize buttons.
for_window [class=".*"] border normal 2
for_window [floating] border normal 2

# blue is sacred — stock i3 palette, stated explicitly as spec
client.focused          #4c7899 #285577 #ffffff #2e9ef4 #285577
client.focused_inactive #333333 #5f676a #ffffff #484e50 #5f676a
client.unfocused        #333333 #222222 #888888 #292d2e #222222
client.urgent           #2f343a #900000 #ffffff #900000 #900000

# ---- psychod: cascade, exact snapping, minimize, drag-snap, mru, show desktop ----
exec_always --no-startup-id flock -n /tmp/psychod-${DISPLAY#:}.lock psychod

# minimize with geometry restore
bindsym $mod+m nop psycho:min
bindsym $mod+Shift+m nop psycho:restore

# snapping: exact workarea rects, computed by psychod
bindsym $mod+Left  nop psycho:snap:left
bindsym $mod+Right nop psycho:snap:right
bindsym $mod+Up    nop psycho:snap:max
bindsym $mod+Down  nop psycho:snap:center

# quarters: $mod+Ctrl+1..4 = TL TR BL BR
bindsym $mod+Ctrl+1 nop psycho:snap:tl
bindsym $mod+Ctrl+2 nop psycho:snap:tr
bindsym $mod+Ctrl+3 nop psycho:snap:bl
bindsym $mod+Ctrl+4 nop psycho:snap:br

# alt-tab: cycle windows in most-recent-first order (pause 1.2s to commit)
bindsym $mod+Tab nop psycho:cycle

# show desktop
bindsym $mod+Shift+d nop psycho:showdesktop

# expose: every float arranged in a grid; toggle, click, or cycle to exit.
# hot corners (psychod defaults): top-left = expose, bottom-right = show desktop
bindsym $mod+e nop psycho:expose

# tiling still exists, you monster
bindsym $mod+t floating toggle

# ---- standard i3 survival kit ----
bindsym $mod+Return exec i3-sensible-terminal
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id dmenu_run
bindsym $mod+f fullscreen toggle

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec i3-nagbar -t warning -m 'Exit i3psycho?' -B 'Yes' 'i3-msg exit'

bar {
    status_command i3status
    position bottom
    colors {
        background #000000
        statusline #ffffff
        separator  #666666
        focused_workspace  #4c7899 #285577 #ffffff
        inactive_workspace #333333 #222222 #888888
        urgent_workspace   #2f343a #900000 #ffffff
    }
}

# ---- knobs (defaults shown; all optional) ----
# psycho_genie_duration 140          # minimize/restore ghost, ms; 0 disables
# psycho_titlebar_buttons yes
# psycho_double_click_titlebar yes
# psycho_snap_edges yes
# psycho_snap_margin 10              # px from the edge that triggers the snap preview
# psycho_chips yes                   # minimized-window chips in i3bar
