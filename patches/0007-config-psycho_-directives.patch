+    config.psycho_double_click_titlebar = boolstr(value);
+}
+
+CFGFUN(psycho_snap_edges, const char *value) {
+    config.psycho_snap_edges = boolstr(value);
+}
+
+CFGFUN(psycho_snap_margin, const long margin) {
+    config.psycho_snap_margin = margin;
+}
+
+CFGFUN(psycho_chips, const char *value) {
+    config.psycho_chips = boolstr(value);
+}
+
 CFGFUN(focus_follows_mouse, const char *value) {
     config.disable_focus_follows_mouse = !boolstr(value);
 }
