--- a/src/click.c
+++ b/src/click.c
@@ -286,6 +286,35 @@ static void route_click(Con *con, xcb_button_press_event_t *event, const click_d
             return;
         }
 
+        /* 5b: titlebar buttons (close / iconify / maximize). They win over
+         * resize/drag handling, like in classic floating window managers. */
+        if (dest == CLICK_DECORATION && is_left_click && !mod_pressed) {
+            const int deco_button = deco_button_at(con, event->event_x - con->deco_rect.x);
+            if (deco_button >= 0) {
+                deco_button_press(con, (deco_button_t)deco_button);
+                xcb_allow_events(conn, XCB_ALLOW_ASYNC_POINTER, event->time);
+                xcb_flush(conn);
+                return;
+            }
+        }
+
+        /* 5c: double-clicking the titlebar toggles fullscreen (the classic
+         * titlebar double-click maximize). */
+        static xcb_window_t last_deco_frame = XCB_NONE;
+        static xcb_timestamp_t last_deco_time = 0;
+        if (dest == CLICK_DECORATION && is_left_click && !mod_pressed) {
+            if (event->event == last_deco_frame &&
+                event->time - last_deco_time < 400) {
+                last_deco_frame = XCB_NONE;
+                con_toggle_fullscreen(con, CF_OUTPUT);
+                tree_render();
+                allow_replay_pointer(event->time);
+                return;
+            }
+            last_deco_frame = event->event;
+            last_deco_time = event->time;
+        }
+
         /*  6: resize (floating) if this was a (left or right) click on the
          * left/right/bottom border, or a right click on the decoration.
          * also try resizing (tiling) if possible */
diff --git a/src/deco_buttons.c b/src/deco_buttons.c
new file mode 100644
index 00000000..0332fec6
--- /dev/null
+++ b/src/deco_buttons.c
@@ -0,0 +1,60 @@
+/*
+ * vim:ts=4:sw=4:expandtab
+ *
+ * i3 - an improved tiling window manager
+ * © 2009 Michael Stapelberg and contributors (see also: LICENSE)
+ *
+ * deco_buttons.c: Titlebar buttons (close / iconify / maximize) for floating
+ * windows. Close kills the window, iconify moves it to the scratchpad (i3’s
+ * native iconification), maximize toggles fullscreen. Buttons are drawn by
+ * x_draw_decoration() and hit-tested from route_click().
+ *
+ */
+#include "all.h"
+
+bool deco_buttons_visible(Con *con) {
+    if (con->window == NULL) {
+        return false;
+    }
+    if (con_inside_floating(con) == NULL) {
+        return false;
+    }
+    if (con->deco_rect.height == 0) {
+        return false;
+    }
+    /* Leave the majority of the titlebar for dragging and the title. */
+    return (int)con->deco_rect.width > deco_buttons_width(con) * 2;
+}
+
+int deco_buttons_width(Con *con) {
+    return DECO_BUTTON_COUNT * (int)con->deco_rect.height;
+}
+
+int deco_button_at(Con *con, int x) {
+    if (!deco_buttons_visible(con)) {
+        return -1;
+    }
+    if (x < 0 || x >= deco_buttons_width(con)) {
+        return -1;
+    }
+    return x / (int)con->deco_rect.height;
+}
+
+void deco_button_press(Con *con, deco_button_t button) {
+    DLOG("titlebar button %d pressed for con %p\n", button, con);
+    switch (button) {
+        case DECO_BUTTON_CLOSE:
+            tree_close_internal(con, KILL_WINDOW, false);
+            break;
+        case DECO_BUTTON_ICONIFY:
+            scratchpad_move(con);
+            break;
+        case DECO_BUTTON_MAXIMIZE:
+            con_toggle_fullscreen(con, CF_OUTPUT);
+            break;
+        default:
+            ELOG("BUG: invalid titlebar button %d\n", button);
+            return;
+    }
+    tree_render();
+}
