From: Ezra Kruger <ekruges@users.noreply.github.com>
Date: Mon, 27 Jul 2026 06:31:00 -0400
Subject: [PATCH 6/7] scratchpad: minimize and restore genie animation

A hollow outline box in the focused border color slides from the
window down to the chip area on minimize and back on restore, about
220ms, shape-extension only, no compositor needed. I3PSYCHO_GENIE_MS
overrides the duration; 0 disables.
---
 include/floating.h |  8 +++++++
 src/floating.c     | 53 ++++++++++++++++++++++++++++++++++++++++++++++
 src/handlers.c     |  8 +++----
 src/scratchpad.c   | 28 ++++++++++++++++++++++++
 4 files changed, 92 insertions(+), 5 deletions(-)

diff --git a/include/floating.h b/include/floating.h
index 781bb130..9278a855 100644
--- a/include/floating.h
+++ b/include/floating.h
@@ -107,6 +107,14 @@ void floating_check_size(Con *floating_con, bool prefer_height);
  */
 bool floating_reposition(Con *con, Rect newrect);
 
+/**
+ * Animates a hollow outline rectangle between the two rects (the classic
+ * minimize/restore genie box). Blocks for the duration (~220ms default,
+ * I3PSYCHO_GENIE_MS overrides, 0 disables).
+ *
+ */
+void floating_genie_animate(Rect from, Rect to);
+
 /**
  * Sets size of the CT_FLOATING_CON to specified dimensions. Might limit the
  * actual size with regard to size constraints taken from user settings.
diff --git a/src/floating.c b/src/floating.c
index fec1419b..39c70917 100644
--- a/src/floating.c
+++ b/src/floating.c
@@ -685,6 +685,59 @@ static void snap_preview_hide(void) {
     snap_current = SNAP_NONE;
 }
 
+void floating_genie_animate(Rect from, Rect to) {
+    int duration_ms = 220;
+    const char *env = getenv("I3PSYCHO_GENIE_MS");
+    if (env != NULL) {
+        duration_ms = atoi(env);
+    }
+    if (duration_ms <= 0) {
+        return;
+    }
+    const int frames = 12;
+    const int thick = logical_px(2);
+
+    xcb_window_t ghost = xcb_generate_id(conn);
+    uint32_t mask = XCB_CW_BACK_PIXEL | XCB_CW_OVERRIDE_REDIRECT;
+    uint32_t values[] = {config.client.focused.border.colorpixel, 1};
+    xcb_create_window(conn, XCB_COPY_FROM_PARENT, ghost, root,
+                      from.x, from.y, from.width, from.height, 0,
+                      XCB_WINDOW_CLASS_INPUT_OUTPUT, XCB_COPY_FROM_PARENT,
+                      mask, values);
+
+    for (int i = 0; i <= frames; i++) {
+        const double t = (double)i / frames;
+        const Rect r = {
+            from.x + (int)(((int)to.x - (int)from.x) * t),
+            from.y + (int)(((int)to.y - (int)from.y) * t),
+            (uint32_t)max(4, (int)from.width + (int)(((int)to.width - (int)from.width) * t)),
+            (uint32_t)max(4, (int)from.height + (int)(((int)to.height - (int)from.height) * t)),
+        };
+        const uint16_t w = r.width, h = r.height;
+        xcb_rectangle_t strips[4] = {
+            {0, 0, w, (uint16_t)thick},
+            {0, (int16_t)(h - thick), w, (uint16_t)thick},
+            {0, 0, (uint16_t)thick, h},
+            {(int16_t)(w - thick), 0, (uint16_t)thick, h},
+        };
+        xcb_shape_rectangles(conn, XCB_SHAPE_SO_SET, XCB_SHAPE_SK_BOUNDING,
+                             XCB_CLIP_ORDERING_UNSORTED, ghost, 0, 0, 4, strips);
+        uint32_t cfg[] = {(uint32_t)r.x, (uint32_t)r.y, w, h, XCB_STACK_MODE_ABOVE};
+        xcb_configure_window(conn, ghost,
+                             XCB_CONFIG_WINDOW_X | XCB_CONFIG_WINDOW_Y |
+                                 XCB_CONFIG_WINDOW_WIDTH | XCB_CONFIG_WINDOW_HEIGHT |
+                                 XCB_CONFIG_WINDOW_STACK_MODE,
+                             cfg);
+        if (i == 0) {
+            xcb_map_window(conn, ghost);
+        }
+        xcb_flush(conn);
+        usleep((duration_ms * 1000) / frames);
+    }
+    xcb_destroy_window(conn, ghost);
+    xcb_flush(conn);
+}
+
 DRAGGING_CB(drag_window_callback) {
     /* Reposition the client correctly while moving */
     con->rect.x = old_rect->x + (new_x - event->root_x);
