-handler_t handlers[13] = {
+/*
+ * Formats the reply message for a GET_SCRATCHPAD request: one entry per
+ * scratchpad (minimized) window with what a taskbar needs to render it.
+ *
+ */
+IPC_HANDLER(get_scratchpad) {
+    yajl_gen gen = ygenalloc();
