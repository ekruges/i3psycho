+/*
+ * vim:ts=4:sw=4:expandtab
+ *
+ * i3 - an improved tiling window manager
+ * © 2009 Michael Stapelberg and contributors (see also: LICENSE)
+ *
+ * deco_buttons.h: Titlebar buttons (close / iconify / maximize) for floating
+ * windows, in the tradition of classic floating window managers.
+ *
+ */
+#pragma once
+
+#include <config.h>
+
+#include "data.h"
+
+/* Button order, left to right (macOS-style placement on the left side). */
+typedef enum {
+    DECO_BUTTON_CLOSE = 0,
+    DECO_BUTTON_ICONIFY = 1,
+    DECO_BUTTON_MAXIMIZE = 2,
+    DECO_BUTTON_COUNT = 3
+} deco_button_t;
+
+/**
+ * Returns true if the given con gets titlebar buttons: a floating leaf
+ * window whose decoration is tall enough and wide enough to hold them.
+ *
+ */
+bool deco_buttons_visible(Con *con);
+
+/**
+ * Total width of the button area in pixels. Each button occupies a square
+ * slot of deco_rect.height pixels.
+ *
+ */
+int deco_buttons_width(Con *con);
+
+/**
+ * Returns the button at the given x offset (relative to the decoration),
+ * or -1 if the offset is outside the button area.
+ *
+ */
+int deco_button_at(Con *con, int x);
+
+/**
+ * Performs the action for the given button on the given con.
+ *
+ */
+void deco_button_press(Con *con, deco_button_t button);
