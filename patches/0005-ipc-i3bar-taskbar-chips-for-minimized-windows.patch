+            }
+            chip_x += chip_w + chip_sp;
+            sp_index++;
+        }
+    }
+
     if (child_want_click_events() && x > workspace_width) {
         const int tray_width = get_tray_width(walk->trayclients);
         /* Calculate the horizontal coordinate (x) of the start of the
@@ -2169,6 +2189,59 @@ void draw_bars(bool unhide) {
             }
         }
 
+        /* Chips for minimized windows, taskbar-style. */
+        if (!config.disable_ws && !TAILQ_EMPTY(&sp_items)) {
+            const int chip_w = bar_height + logical_px(6);
+            const int chip_sp = logical_px(4);
+            workspace_width += logical_px(10);
+            sp_item *sp_walk;
+            TAILQ_FOREACH (sp_walk, &sp_items, entries) {
+                color_t chip_fg = colors.inactive_ws_fg;
+                color_t chip_bg = colors.inactive_ws_bg;
+                color_t chip_border = colors.inactive_ws_border;
+                if (sp_walk->urgent) {
+                    unhide = true;
+                    if (sp_pulse_on) {
+                        chip_fg = colors.urgent_ws_fg;
+                        chip_bg = colors.urgent_ws_bg;
+                        chip_border = colors.urgent_ws_border;
+                    }
+                }
+                draw_util_rectangle(&(outputs_walk->buffer), chip_border,
+                                    workspace_width, logical_px(1),
+                                    chip_w, bar_height - 2 * logical_px(1));
+                draw_util_rectangle(&(outputs_walk->buffer), chip_bg,
+                                    workspace_width + logical_px(1), 2 * logical_px(1),
+                                    chip_w - 2 * logical_px(1), bar_height - 4 * logical_px(1));
+                if (sp_walk->icon != NULL) {
+                    const int icon_size = bar_height - 2 * logical_px(4);
+                    const int icon_max = sp_walk->icon_w > sp_walk->icon_h ? sp_walk->icon_w : sp_walk->icon_h;
+                    const double scale = (double)icon_size / icon_max;
+                    cairo_t *cr = outputs_walk->buffer.cr;
+                    cairo_save(cr);
+                    cairo_translate(cr,
+                                    workspace_width + (chip_w - sp_walk->icon_w * scale) / 2.0,
+                                    (bar_height - sp_walk->icon_h * scale) / 2.0);
+                    cairo_scale(cr, scale, scale);
+                    cairo_set_source_surface(cr, sp_walk->icon, 0, 0);
+                    cairo_pattern_set_filter(cairo_get_source(cr), CAIRO_FILTER_GOOD);
+                    cairo_paint(cr);
+                    cairo_restore(cr);
+                } else if (sp_walk->letter != NULL) {
+                    const int letter_width = predict_text_width(sp_walk->letter);
+                    draw_util_text(sp_walk->letter, &(outputs_walk->buffer),
+                                   chip_fg, chip_bg,
+                                   workspace_width + (chip_w - letter_width) / 2,
+                                   bar_height / 2 - font.height / 2,
+                                   chip_w);
+                }
+                workspace_width += chip_w;
+                if (TAILQ_NEXT(sp_walk, entries) != NULL) {
+                    workspace_width += chip_sp;
+                }
+            }
+        }
+
         if (binding.name && !config.disable_binding_mode_indicator) {
             workspace_width += logical_px(ws_spacing_px);
 
