+    /* i3psycho: genie duration in ms (0 disables), titlebar buttons,
+     * double-click-titlebar fullscreen, drag-edge snapping and its pointer
+     * margin, taskbar chips. */
+    int psycho_genie_duration;
+    bool psycho_titlebar_buttons;
+    bool psycho_double_click_titlebar;
+    bool psycho_snap_edges;
+    int psycho_snap_margin;
+    bool psycho_chips;
+
     /** Title alignment options. */
     enum {
         ALIGN_LEFT,
diff --git a/parser-specs/config.spec b/parser-specs/config.spec
index d1528374..ffc2420a 100644
--- a/parser-specs/config.spec
+++ b/parser-specs/config.spec
@@ -40,6 +40,12 @@ state INITIAL:
   'assign'                                 -> ASSIGN
   'no_focus'                               -> NO_FOCUS
   'focus_follows_mouse'                    -> FOCUS_FOLLOWS_MOUSE
+  'psycho_genie_duration'                  -> PSYCHO_GENIE_DURATION
+  'psycho_titlebar_buttons'                -> PSYCHO_TITLEBAR_BUTTONS
+  'psycho_double_click_titlebar'           -> PSYCHO_DOUBLE_CLICK_TITLEBAR
+  'psycho_snap_edges'                      -> PSYCHO_SNAP_EDGES
+  'psycho_snap_margin'                     -> PSYCHO_SNAP_MARGIN
+  'psycho_chips'                           -> PSYCHO_CHIPS
   'mouse_warping'                          -> MOUSE_WARPING
   'focus_wrapping'                         -> FOCUS_WRAPPING
   'force_focus_wrapping'                   -> FORCE_FOCUS_WRAPPING
@@ -273,6 +279,36 @@ state CRITERION_STR:
   cvalue = word
       -> call cfg_criteria_add($ctype, $cvalue); CRITERIA
 
+# psycho_genie_duration <ms> (0 disables)
+state PSYCHO_GENIE_DURATION:
+  duration = number
+      -> call cfg_psycho_genie_duration(&duration)
+
+# psycho_titlebar_buttons bool
+state PSYCHO_TITLEBAR_BUTTONS:
+  value = word
+      -> call cfg_psycho_titlebar_buttons($value)
+
+# psycho_double_click_titlebar bool
+state PSYCHO_DOUBLE_CLICK_TITLEBAR:
+  value = word
+      -> call cfg_psycho_double_click_titlebar($value)
+
+# psycho_snap_edges bool
+state PSYCHO_SNAP_EDGES:
+  value = word
+      -> call cfg_psycho_snap_edges($value)
+
+# psycho_snap_margin <px>
+state PSYCHO_SNAP_MARGIN:
+  margin = number
+      -> call cfg_psycho_snap_margin(&margin)
+
+# psycho_chips bool
+state PSYCHO_CHIPS:
+  value = word
+      -> call cfg_psycho_chips($value)
+
 # focus_follows_mouse bool
 state FOCUS_FOLLOWS_MOUSE:
   value = word
