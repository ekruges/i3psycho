     }
 
+    /* The classic minimize genie: an outline box slides down toward the
+     * taskbar chips. */
+    if (genie_ws != NULL && !con_is_internal(genie_ws)) {
+        int idx = 0;
+        Con *count_walk;
+        TAILQ_FOREACH (count_walk, &(__i3_scratch->floating_head), floating_windows) {
+            idx++;
+        }
+        const Rect target = {genie_ws->rect.x + logical_px(16) + idx * logical_px(28),
+                             genie_ws->rect.y + genie_ws->rect.height - logical_px(20),
+                             (uint32_t)logical_px(24), (uint32_t)logical_px(18)};
+        floating_genie_animate(con->rect, target);
+    }
+
     /* 2: Send the window to the __i3_scratch workspace, mainting its
      * coordinates and not warping the pointer. */
     con_move_to_workspace(con, __i3_scratch, true, true, false);
@@ -211,6 +226,19 @@ bool scratchpad_show(Con *con) {
         floating_center(con, con_get_workspace(con)->rect);
     }
 
+    /* Reverse genie on restore: the outline box slides back up into place. */
+    {
+        int idx = 0;
+        Con *count_walk;
+        TAILQ_FOREACH (count_walk, &(__i3_scratch->floating_head), floating_windows) {
+            idx++;
+        }
+        const Rect source = {active->rect.x + logical_px(16) + idx * logical_px(28),
+                             active->rect.y + active->rect.height - logical_px(20),
+                             (uint32_t)logical_px(24), (uint32_t)logical_px(18)};
+        floating_genie_animate(source, con->rect);
+    }
+
     /* Activate active workspace if window is from another workspace to ensure
